# ── Fokus-Postfach — Umgebungsvariablen ──────────────────────────────
# Diese Datei nach .env kopieren und ausfüllen. .env wird NICHT committet.

# Claude / Anthropic API-Key. Ohne Key läuft die Einstufung regelbasiert
# (funktioniert, ist aber deutlich ungenauer als mit KI).
ANTHROPIC_API_KEY=

# Port des Dashboards
PORT=4330

# Wie oft die Postfächer geprüft werden (Minuten)
POLL_INTERVAL_MIN=5

# Wie viele Tage zurück beim Abruf geschaut wird
SINCE_DAYS=7

# ── Gmail (IMAP + App-Passwort) ──────────────────────────────────────
# App-Passwort erstellen: https://myaccount.google.com/apppasswords
# (setzt aktivierte 2-Faktor-Anmeldung voraus)
GMAIL_1_USER=
GMAIL_1_PASS=
GMAIL_2_USER=
GMAIL_2_PASS=

# ── Outlook / Microsoft 365 (Microsoft Graph, nur Lesen) ─────────────
# Client-ID der eigenen App-Registrierung (siehe README, Abschnitt Outlook).
OUTLOOK_CLIENT_ID=
# "consumers" für private outlook.com/hotmail-Konten,
# "organizations" für Firmen-Konten (Microsoft 365), sonst "common".
OUTLOOK_TENANT=common
